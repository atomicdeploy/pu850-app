<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="32dp">

    <!-- Illustration/Icon area with glow -->
    <View
        android:id="@+id/glowEffect"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_glow_circle"
        android:alpha="0.5"
        app:layout_constraintBottom_toTopOf="@id/featureIcon"
        app:layout_constraintEnd_toEndOf="@id/featureIcon"
        app:layout_constraintStart_toStartOf="@id/featureIcon"
        app:layout_constraintTop_toTopOf="@id/featureIcon" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iconCard"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:cardBackgroundColor="@color/elevatedBackground"
        app:cardCornerRadius="80dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3">

        <ImageView
            android:id="@+id/featureIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_icon_wifi"
            app:tint="@color/colorPrimary" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Title -->
    <TextView
        android:id="@+id/featureTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/iransans"
        android:gravity="center"
        android:text="@string/onboarding_title_1"
        android:textColor="@color/colorForeground"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconCard" />

    <!-- Description -->
    <TextView
        android:id="@+id/featureDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/iransans"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/onboarding_desc_1"
        android:textColor="@color/colorGrayText"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/featureTitle" />

    <!-- Feature highlights -->
    <LinearLayout
        android:id="@+id/highlightsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="start"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/featureDescription">

        <LinearLayout
            android:id="@+id/highlight1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_icon_check"
                app:tint="@color/colorSuccess" />

            <TextView
                android:id="@+id/highlightText1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/iransans"
                android:text="@string/onboarding_highlight_1_1"
                android:textColor="@color/colorForeground"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/highlight2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_icon_check"
                app:tint="@color/colorSuccess" />

            <TextView
                android:id="@+id/highlightText2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/iransans"
                android:text="@string/onboarding_highlight_1_2"
                android:textColor="@color/colorForeground"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/highlight3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_icon_check"
                app:tint="@color/colorSuccess" />

            <TextView
                android:id="@+id/highlightText3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/iransans"
                android:text="@string/onboarding_highlight_1_3"
                android:textColor="@color/colorForeground"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
