<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fontFamily="@font/iransans"
    tools:context=".MainActivity">

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Connection Status -->
        <ImageView
            android:id="@+id/imageViewIconConnection"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/ic_icon_wifi"
            app:tint="@color/colorGrayText" />

        <TextView
            android:id="@+id/textViewServerAddr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="0.0.0.0:0"
            android:textColor="@color/colorGrayText"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Version -->
        <TextView
            android:id="@+id/textViewAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="ver"
            android:textColor="@color/colorGrayText"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Logo Section -->
    <ImageView
        android:id="@+id/imageViewLogo"
        android:layout_width="120dp"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/pu850app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topStatusBar"
        app:srcCompat="@drawable/ic_logo_pand" />

    <!-- Weight Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/weightDisplayCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageViewLogo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_display_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Serial Number & User Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- User Info -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/imageViewUserIconCard"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imageViewUserIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@color/colorPrimary"
                        android:padding="6dp"
                        app:srcCompat="@drawable/ic_icon_user"
                        app:tint="@android:color/white" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textViewUserName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/iransans"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:text="@string/username"
                    android:textColor="@color/colorPanelTextSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewSerialNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/SN"
                    android:textColor="@color/colorPanelTextSecondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Weight Display -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazircode"
                    android:gravity="center"
                    android:minHeight="80dp"
                    android:text="@string/Weight"
                    android:textColor="@color/colorPanelText"
                    android:textSize="52sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewKg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/iransans"
                    android:text="Kg"
                    android:textColor="@color/colorPanelTextSecondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Status Message -->
            <TextView
                android:id="@+id/textViewMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/vazircode"
                android:gravity="center"
                android:minHeight="32dp"
                android:text="@string/Message"
                android:textColor="@color/colorPanelTextSecondary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons Grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/actionButtonsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/weightDisplayCard">

        <!-- Row 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTare"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toTopOf="@id/cardPower"
            app:layout_constraintEnd_toStartOf="@id/cardShow"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_tare"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonTare"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Tare"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardShow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toTopOf="@id/cardDevelop"
            app:layout_constraintEnd_toStartOf="@id/cardHide"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toEndOf="@id/cardTare"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_show"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonShow"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Show"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toTopOf="@id/cardConnect"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toEndOf="@id/cardShow"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_hide"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonHide"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Hide"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Row 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPower"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toTopOf="@id/cardReceipt"
            app:layout_constraintEnd_toStartOf="@id/cardDevelop"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardTare">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_power"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonPower"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Power"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDevelop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:alpha="0.6"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toTopOf="@id/cardReport"
            app:layout_constraintEnd_toStartOf="@id/cardConnect"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toEndOf="@id/cardPower"
            app:layout_constraintTop_toBottomOf="@id/cardShow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_develop"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonDevelop"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Develop"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConnect"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toTopOf="@id/cardSettings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toEndOf="@id/cardDevelop"
            app:layout_constraintTop_toBottomOf="@id/cardHide">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_net"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonConnect"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Net"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Row 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReceipt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardReport"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPower">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_receipt"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonReceipt"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Receipt"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardSettings"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toEndOf="@id/cardReceipt"
            app:layout_constraintTop_toBottomOf="@id/cardDevelop">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_report"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonReport"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Report"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSettings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:alpha="0.6"
            app:cardBackgroundColor="@color/elevatedBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.30"
            app:layout_constraintStart_toEndOf="@id/cardReport"
            app:layout_constraintTop_toBottomOf="@id/cardConnect">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_key_settings"
                    app:tint="@color/colorPrimary" />

                <Button
                    android:id="@+id/buttonSettings"
                    style="@style/Widget.PU850.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="0dp"
                    android:padding="4dp"
                    android:text="@string/Settings"
                    android:textColor="@color/colorForeground"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hidden guideline for compatibility -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="0dp" />

    <!-- Print Paper Overlay (kept for functionality) -->
    <ImageView
        android:id="@+id/imageViewPrintPaper"
        android:layout_width="16dp"
        android:layout_height="300dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:translationZ="90dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/weightDisplayCard"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>