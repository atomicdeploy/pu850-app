<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorPrimary">@color/colorBackground</item>
        <item name="colorPrimaryDark">@color/colorForeground</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorError">@color/colorError</item>
        <item name="android:disabledAlpha">0.6</item>
        <item name="android:textColorPrimary">@color/colorForeground</item>
        <item name="android:textColorHint">@color/colorGrayText</item>
        <item name="android:fontFamily">@font/iransans</item>
        <item name="fontFamily">@font/iransans</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:textDirection">locale</item>
        <item name="numberPickerTheme">@style/NumberPickerStyle</item>
        <item name="android:alertDialogStyle">@style/AlertDialogStyle</item>
        <item name="alertDialogStyle">@style/AlertDialogStyle</item>
        <item name="android:alertDialogTheme">@style/AlertDialogStyle</item>
        <item name="alertDialogTheme">@style/AlertDialogStyle</item>
        <item name="android:progressBarStyleHorizontal">@style/ProgressBarHorizontalStyle</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
        <item name="android:buttonStyle">@style/ButtonStyle</item>
        <item name="buttonStyle">@style/ButtonStyle</item>
        <item name="android:textViewStyle">@style/TextViewStyle</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
    </style>

    <style name="AlertDialogStyle" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rounded_dialog</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:textColor">@color/colorForeground</item>
        <item name="android:textColorPrimary">@color/colorForeground</item>
        <item name="android:fontFamily">@font/iransans</item>
        <item name="android:layoutDirection">locale</item>
        <item name="android:textAppearanceSmall">@style/TextAppearanceSmall</item>
        <item name="android:textAppearanceMedium">@style/TextAppearanceMedium</item>
        <item name="android:textAppearanceLarge">@style/TextAppearanceLarge</item>
    </style>

    <style name="ProgressDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/rounded_dialog</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:textColor">@color/colorForeground</item>
        <item name="android:textColorPrimary">@color/colorForeground</item>
        <item name="android:indeterminateTint">@color/colorAccent</item>
        <item name="android:fontFamily">@font/iransans</item>
        <item name="android:layoutDirection">locale</item>
        <item name="android:textAppearanceSmall">@style/TextAppearanceSmall</item>
        <item name="android:textAppearanceMedium">@style/TextAppearanceMedium</item>
        <item name="android:textAppearanceLarge">@style/TextAppearanceLarge</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/rounded_dialog_bottom</item>
        <item name="android:colorAccent">@color/colorBackground</item>
        <item name="android:textColor">@color/colorForeground</item>
        <item name="android:textColorPrimary">@color/colorForeground</item>
        <item name="android:indeterminateTint">@color/colorAccent</item>
        <item name="android:fontFamily">@font/iransans</item>
        <item name="android:layoutDirection">locale</item>
        <item name="android:textAppearanceSmall">@style/TextAppearanceSmall</item>
        <item name="android:textAppearanceMedium">@style/TextAppearanceMedium</item>
        <item name="android:textAppearanceLarge">@style/TextAppearanceLarge</item>
    </style>

    <style name="NumberPickerStyle">
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:textColorPrimary">@color/colorForeground</item> <!-- text color -->
        <item name="colorControlNormal">@color/colorAccent</item> <!-- divider color -->
        <item name="android:fontFamily">@font/iransans</item>
        <item name="android:textAppearanceSmall">@style/TextAppearanceSmall</item>
        <item name="android:textAppearanceMedium">@style/TextAppearanceMedium</item>
        <item name="android:textAppearanceLarge">@style/TextAppearanceLarge</item>
    </style>

    <style name="ProgressBarHorizontalStyle" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_horizontal</item>
        <item name="android:indeterminateDrawable">@drawable/progress_horizontal_indeterminate</item>
        <item name="android:minHeight">8dip</item>
        <item name="android:maxHeight">20dip</item>
        <item name="trackThickness">15dip</item>
        <item name="trackCornerRadius">5dip</item>
        <item name="android:scaleY">1</item>
        <item name="android:layout_height">20dp</item>
    </style>

    <style name="AppTheme.EditText" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorPrimary">@color/colorBackground</item>
        <item name="colorPrimaryDark">@color/colorForeground</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorError">@color/colorError</item>
        <item name="android:disabledAlpha">0.6</item>
        <item name="android:textColorPrimary">@color/colorForeground</item>
        <item name="android:textColorHint">@color/colorGrayText</item>
        <item name="android:fontFamily">@font/iransans</item>
        <item name="fontFamily">@font/iransans</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:textDirection">locale</item>
        <item name="android:textViewStyle">@style/TextViewStyle</item>
    </style>

    <style name="TextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/iransans</item>
    </style>

    <style name="TextAppearanceSmall" parent="TextAppearance.AppCompat.Small">
        <item name="android:fontFamily">@font/iransans</item>
    </style>

    <style name="TextAppearanceMedium" parent="TextAppearance.AppCompat.Medium">
        <item name="android:fontFamily">@font/iransans</item>
    </style>

    <style name="TextAppearanceLarge" parent="TextAppearance.AppCompat.Large">
        <item name="android:fontFamily">@font/iransans</item>
    </style>

    <style name="ButtonStyle" parent="Widget.AppCompat.Button">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/iransans</item>
    </style>

    <style name="TextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/iransans</item>
    </style>

</resources>
